# ============================================================
# ATK Agent CLI 配置
# ============================================================

# --- LLM Provider 配置 ---
# Provider 类型: deepseek | qwen | openai | ollama
AI_PROVIDER=deepseek

# API Key (deepseek/qwen/openai 必填，ollama 不需要)
AI_API_KEY=your-api-key-here

# 模型名称
AI_MODEL=deepseek-chat

# API Base URL (可选，OpenAI 兼容接口地址)
# DeepSeek:  https://api.deepseek.com/v1
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI:    https://api.openai.com/v1
# 本地 vLLM: http://localhost:8000/v1
AI_BASE_URL=https://api.deepseek.com/v1

# Ollama (本地模型)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# --- ATK 配置 ---
# ATK.exe 安装路径
ATK_EXE_PATH=D:\atk-v4.0.0\atk\ATK-v4.0.0-windows-x64\ATK-4.0.0\ATK.exe

# ATK Connect 连接参数
ATK_HOST=127.0.0.1
ATK_PORT=6655

# ATK 启动等待时间（秒）
ATK_STARTUP_WAIT=8

# --- Python Sidecar 配置（过渡阶段使用）---
# ATK Python 模块路径 (ATKConnectModule 所在目录)
ATK_PYTHON_PATH=D:\atk-v4.0.0\atk\ATK-v4.0.0-windows-x64\ATK-4.0.0\IntegratingWithATK\connect\Python

# Python 解释器路径。Windows 版 ATK 4.0.0 模块已验证兼容 Python 3.12；
# 不建议使用 MSYS2 Python 或尚未验证的 Python 3.14。
PYTHON_EXE=.venv\\Scripts\\python.exe

# --- 资源保护硬限制 ---
ATK_MAX_MEMORY_GB=6
ATK_MIN_SYSTEM_FREE_MEMORY_GB=4
ATK_MAX_GPU_MEMORY_PERCENT=80
ATK_MAX_OBJECT_COUNT=1000
ATK_MAX_ESTIMATED_EPHEMERIS_POINTS=2000000

# Session 数据、daemon 状态、审计和检查点目录（可选）
# ATK_AGENT_HOME=D:\atk-agent-data

# 所有交给 ATK 的 SaveAs/Load/导出路径都会先进入这个纯英文临时目录。
# 即使 ATK_AGENT_HOME 或工程目录含中文，这里也必须是绝对、纯 ASCII 路径。
# 未配置时会优先使用系统临时目录下的 atk-agent 子目录。
# ATK_AGENT_ASCII_TEMP=C:\Users\Public\AppData\Local\Temp\atk-agent

# --- 调试 ---
# 启用调试日志
DEBUG=false
